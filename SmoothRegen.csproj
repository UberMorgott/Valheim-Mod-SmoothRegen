<Project Sdk="Microsoft.NET.Sdk">

  <!-- LangVersion, determinism, PathMap, embedded PDB, SourceLink off, ValheimDir/ManagedDir,
       PolySharp and the game's BepInEx + 0Harmony references come from build\Valheim.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ValheimPlugin>true</ValheimPlugin>
    <ValheimUsePublicizer>true</ValheimUsePublicizer>
    <AssemblyName>SmoothRegen</AssemblyName>
    <Product>SmoothRegen</Product>
    <Version>1.1.4</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Valheim ships its own copies; never emit ours next to the plugin. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives under this one; its sources and obj\ are not part of the plugin. -->
    <Compile Remove="SmoothRegen.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game fields we need are private; publicize instead of reflecting. -->
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils" Publicize="true">
      <HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- <Version> is the single source of truth; every copy below must match or the build fails. -->
  <Target Name="CheckVersionSync" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_VsFile1>$(MSBuildProjectDirectory)\manifest.json</_VsFile1>
      <_VsNeedle1>&quot;version_number&quot;: &quot;$(Version)&quot;</_VsNeedle1>
      <_VsText1>$([System.IO.File]::ReadAllText('$(_VsFile1)'))</_VsText1>
      <_VsFile2>$(MSBuildProjectDirectory)\Plugin.cs</_VsFile2>
      <_VsNeedle2>PluginVersion = &quot;$(Version)&quot;</_VsNeedle2>
      <_VsText2>$([System.IO.File]::ReadAllText('$(_VsFile2)'))</_VsText2>
    </PropertyGroup>
    <Error Condition="'$(_VsText1.Contains($(_VsNeedle1)))' != 'true'"
           Text="manifest.json does not carry &lt;Version&gt; $(Version) of SmoothRegen.csproj (expected: $(_VsNeedle1))." />
    <Error Condition="'$(_VsText2.Contains($(_VsNeedle2)))' != 'true'"
           Text="Plugin.cs does not carry &lt;Version&gt; $(Version) of SmoothRegen.csproj (expected: $(_VsNeedle2))." />
  </Target>

</Project>
